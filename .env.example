# Salin ke .env.local (lokal) atau set di Vercel > Settings > Environment Variables.
# JANGAN PERNAH commit .env.local ke git.

# Token bot Discord. Wajib. Hanya bisa dibaca di server.
DISCORD_BOT_TOKEN=ganti_dengan_token_bot_kamu

# Id channel testimoni. Wajib. Klik kanan channel > Copy Channel ID.
DISCORD_CHANNEL_ID=ganti_dengan_id_channel

# Opsional. Kalau diisi, hanya embed yang judulnya mengandung teks ini
# yang dipakai. Contoh: "Rating"
TESTIMONIAL_EMBED_TITLE=

# --- Showcase -------------------------------------------------------------
# Id channel showcase, dipisah koma. Wajib kalau mau Showcase terisi dari
# Discord. Contoh: #product-samp dan #digital-service
#   DISCORD_SHOWCASE_CHANNELS=1553622067746840709,1553622274001735782
#
# Kategori website bisa ditulis di sebelah id channel (pisah titik dua) untuk
# memaksa semua produk dari channel itu masuk filter tertentu.
#
#   Format  : <idChannel>:<Kategori>
#   Contoh   : 1553622067746840709:SA-MP,1553622274001735782:Discord
#
# Kategori yang bisa dipakai HANYA lima nama filter yang sudah ada di website:
#   SA-MP   Discord   Bot   Website   UI
# Huruf besar-kecil tidak berpengaruh, jadi "samp" dan "sa-mp" sama-sama
# dibaca sebagai SA-MP. Nilai yang tidak dikenal diabaikan (produknya lalu
# ditebak otomatis dari isi dan nama channel) dan muncul di respons endpoint
# pada field "unknown" supaya tidak hilang tanpa jejak.
#
# Kalau kategorinya dikosongkan saja, kategori ditebak dari nama channel
# (product-samp -> SA-MP, digital-service -> Discord) lalu dari isi produk.
DISCORD_SHOWCASE_CHANNELS=

# Opsional. Id server Discord, dipakai untuk membuat link ke pesan aslinya.
# Klik kanan server > Copy Server ID.
DISCORD_GUILD_ID=
