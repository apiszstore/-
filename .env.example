# Salin ke .env.local (lokal) atau set di Vercel > Settings > Environment Variables.
# JANGAN PERNAH commit .env.local ke git.

# Token bot Discord. Wajib. Hanya bisa dibaca di server.
DISCORD_BOT_TOKEN=ganti_dengan_token_bot_kamu

# Id channel testimoni. Wajib. Klik kanan channel > Copy Channel ID.
DISCORD_CHANNEL_ID=ganti_dengan_id_channel

# Opsional. Kalau diisi, hanya embed yang judulnya mengandung teks ini
# yang dipakai. Contoh: "Rating"
TESTIMONIAL_EMBED_TITLE=
