    "verify:layout": "node verify.mjs",
    "verify:contrast": "node verify-contrast.mjs",
    "verify:content": "node verify-content.mjs",
    "check:url": "node check-url.mjs",
    "og:png": "node tools/og-png.mjs",
    "verify:dist": "node tools/verify-dist.mjs",
    "verify:live": "node tools/verify-live.mjs",
    "test": "node --test --test-reporter=spec \"test/**/*.test.mjs\"",
    "test:discord": "node --test --test-reporter=spec \"test/**/*.test.mjs\""
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.48.0",
